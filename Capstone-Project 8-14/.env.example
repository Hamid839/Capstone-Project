# Copy this file to .env.local (frontend) and/or .env (server) and fill in real values.
# Never commit .env or .env.local — they're already in .gitignore.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/hisabdo
# Or MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/hisabdo

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_EXPIRES_IN=1d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
