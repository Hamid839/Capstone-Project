# Copy this file to .env and fill in your own values.
# Never commit your actual .env file to GitHub.

PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/hisabdo_auth
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hisabdo_auth?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# Secret key used to sign JWTs — use a long, random string in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# How long issued tokens remain valid (e.g. 1h, 1d, 7d)
JWT_EXPIRE=1d
